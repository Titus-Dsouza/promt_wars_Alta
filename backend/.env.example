# Local development defaults. Keep real credentials in backend/.env (ignored by Git).
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=

# Optional locally; required in production for persistent Django database access.
# Example: postgresql://USER:PASSWORD@HOST:5432/mediscribe?sslmode=require
DATABASE_URL=

# Google Gemini API. Never put this value in frontend code or commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
