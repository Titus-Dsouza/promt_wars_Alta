# MediScribe Environment Configuration

# Django Settings
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Google Gemini API & Gemma 4 Configuration
# Provide your Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
# Target Gemma 4 model (supported models include gemma-4-31b-it, gemma-4-26b-a4b-it)
GEMMA_MODEL=gemma-4-31b-it
